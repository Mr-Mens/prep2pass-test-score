# PassReady environment variables (placeholders only)

# Supabase (required in production to save payments + reports after checkout)
# Project URL must end with .supabase.co (not .com). Copy from Dashboard → Settings → API.
# Enable Email provider; set Site URL + Redirect URLs (e.g. http://localhost:3000/auth/callback, production /auth/callback).
# Require email confirmations for production; schema includes user_entitlements + reports.user_id (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ACCESS_KEY=

# Instructor workspace (/instructor/*): role is set automatically when signing up via welcome → Instructor.
# To promote an existing account manually: node scripts/promote-instructor.mjs user@example.com

# Parent / Supervisor workspace (/supervisor/*): run migration 006 in Supabase SQL Editor after 005.
# Instructor pupil invitations (pending accept + in-app notifications): run migration 007 after 006.
# Learner mock test deliveries (instructor sends completed mock tests): run migration 008 after 007.
# V1 commercial model (subscriptions, referrals, graduate mode): run migration 010 after 009.
# Instructor referral commissions (15%, manual payouts): run migration 021 after 010.
# Tables: parent_profiles, parent_learner_links, practice_logs
# Parent role is set automatically on signup when user chooses Parent on welcome; or manually:
# INSERT INTO public.user_app_profiles (user_id, role) VALUES ('<auth user uuid>', 'parent')
# ON CONFLICT (user_id) DO UPDATE SET role = 'parent', updated_at = now();

# Local only: if Supabase is unset, `next dev` still completes checkout without DB.
# For `next start` without Supabase, set this to true (never in real production).
# SKIP_SUPABASE_REPORT_PERSIST=true

# Stripe (subscription checkout for learners)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Learner subscription price (£6.99/month). Stripe Dashboard → Products → recurring Price id price_…
STRIPE_PRICE_ID_SUBSCRIPTION=
# Legacy one-off prices (grandfathered accounts / historical metadata only)
STRIPE_PRICE_ID_SINGLE=
STRIPE_PRICE_ID_LIFETIME=
STRIPE_PRICE_ID=
# Short secret for signed lifetime finalisation tokens (min 16 chars, random)
ENTITLEMENT_TOKEN_SECRET=
# HMAC signing key for temporary "open my saved reports" tokens (magic links + progress clicks). Min 16 chars.
REPORT_ACCESS_TOKEN_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PWA service worker (registers in dev and production). Set to false to disable locally.
# NEXT_PUBLIC_PWA_SW=false
# Vercel: set to your production origin (https://…). Stripe + magic links use this variable.
# If you also set NEXT_PUBLIC_SITE_URL in Vercel, mirror the same value here unless you extend the app to read it.

# OpenAI (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Email (Resend — app-generated transactional emails; Supabase Auth still handles signup/reset)
RESEND_API_KEY=
EMAIL_FROM="Pass Pilot" <hello@thepasspilot.com>
# After enabling Supabase Auth → Hooks → Send Email, paste the generated secret here:
# SUPABASE_AUTH_SEND_EMAIL_HOOK_SECRET=v1,whsec_...
# Legacy alias (optional fallback if EMAIL_FROM is unset)
# REPORT_ACCESS_FROM_EMAIL=
