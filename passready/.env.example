# PassReady environment variables (placeholders only)

# Supabase (required in production to save payments + reports after checkout)
# Project URL must end with .supabase.co (not .com) — copy from Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ACCESS_KEY=

# Local only: if Supabase is unset, `next dev` still completes checkout without DB.
# For `next start` without Supabase, set this to true (never in real production).
# SKIP_SUPABASE_REPORT_PERSIST=true

# Stripe (one-time payment checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Single-report price (£3.99) — create in Stripe Dashboard → Products → Price id price_…
STRIPE_PRICE_ID_SINGLE=
# Lifetime unlimited price (£9.99)
STRIPE_PRICE_ID_LIFETIME=
# Legacy fallback when STRIPE_PRICE_ID_SINGLE is unset (single-tier setups)
STRIPE_PRICE_ID=
# Short secret for signed lifetime finalisation tokens (min 16 chars, random)
ENTITLEMENT_TOKEN_SECRET=
# HMAC signing key for temporary "open my saved reports" tokens (magic links + progress clicks). Min 16 chars.
REPORT_ACCESS_TOKEN_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
